{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  // Local test stack for the PM app (npm run local:up). Runs only in Docker on
  // this machine, on 5532x ports so it never clashes with another project's
  // default 5432x stack. The database is
  // built from ../../supabase/schema.sql, the way a fresh install is; the one
  // migration here only makes the two empty schemas PostgREST needs to start.
  "project_id": "pm-local",

  "api": {
    "enabled": true,
    "port": 55321,
    // The app lives in pm (core) and pm_custom (an install's own).
    "schemas": ["public", "graphql_public", "pm", "pm_custom"],
    "extra_search_path": ["public", "extensions"],
    "max_rows": 1000
  },

  "db": {
    "port": 55322,
    "shadow_port": 55320,
    "health_timeout": "3m",
    "major_version": 17,
    "pooler": { "enabled": false, "port": 55329 },
    "migrations": { "enabled": true },
    "seed": { "enabled": false }
  },

  "realtime": { "enabled": true },

  "studio": {
    "enabled": true,
    "port": 55323,
    "api_url": "http://127.0.0.1"
  },

  // Every email the stack's auth sends (password resets) lands here, never in
  // a real inbox: http://127.0.0.1:55324
  "local_smtp": { "enabled": true, "port": 55324 },

  "storage": {
    "enabled": true,
    "file_size_limit": "50MiB",
    "s3_protocol": { "enabled": false },
    "analytics": { "enabled": false },
    "vector": { "enabled": false }
  },

  "auth": {
    "enabled": true,
    "site_url": "http://localhost:3010",
    "additional_redirect_urls": ["http://localhost:3010/auth/callback", "http://127.0.0.1:3010/auth/callback"],
    "jwt_expiry": 3600,
    "enable_refresh_token_rotation": true,
    "refresh_token_reuse_interval": 10,
    // The app creates every account itself (setup wizard, invites), as the
    // README tells a real install to configure it.
    "enable_signup": false,
    "enable_anonymous_sign_ins": false,
    "enable_manual_linking": true,
    "minimum_password_length": 8,
    "email": {
      "enabled": true,
      "double_confirm_changes": false,
      "enable_confirmations": false,
      "secure_password_change": false,
      "max_frequency": "1s"
    }
  },

  "edge_runtime": { "enabled": false },
  "analytics": { "enabled": false, "port": 55327 }
}
