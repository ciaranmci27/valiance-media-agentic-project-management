# Copy to .env.local and fill in. Set the same values in your host (on Vercel:
# Project, Settings, Environment Variables), with NEXT_PUBLIC_APP_URL set to
# your real address there. Integration keys (Resend, the GitHub update token,
# webhook retries) are set in the app's Settings and saved encrypted, not here.

# Application (required): this app's address.
NEXT_PUBLIC_APP_URL=http://localhost:3009

# Supabase (required): Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (required): 64 hex characters. The setup wizard generates one, or
# run `openssl rand -hex 32`. Use the same key everywhere and keep a safe copy:
# if it is lost, saved passwords and keys cannot be recovered.
APP_ENCRYPTION_KEY=

# Database updates (optional): Supabase, Connect, the session or direct string
# on port 5432 (never the 6543 pooler). Deploys and `npm run db:migrate` use it
# to apply each update's database changes. DATABASE_URL also works.
SUPABASE_DB_URL=

# Scheduled jobs (optional): turns on the crons in vercel.json (inbound email
# clean-up, billing draft digest). At least 16 characters: `openssl rand -hex 32`.
CRON_SECRET=

# Shared Supabase project only (optional): any long random text. Needed to
# claim the Owner account when the project already holds other apps' logins.
PM_SETUP_CODE=

# --- Rarely needed ----------------------------------------------------------
# `false` keeps production deploys from ever changing the database.
MIGRATE_ON_DEPLOY=
# Demo mode with no database: set both to true.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
# Advanced: trusted Authentication-Results ids. Keep it unset with Resend.
INBOUND_EMAIL_TRUSTED_AUTHSERV_IDS=
# Advanced: `true` lets webhooks go to private addresses (receivers on your own
# network). Off by default: endpoints must be public. Local dev allows them.
WEBHOOKS_ALLOW_PRIVATE_TARGETS=

# --- Older installs only ----------------------------------------------------
# Before 1.10: keep these until Settings > Workspace > Encryption has nothing
# left to move, then remove them.
# SMTP_ENCRYPTION_KEY=
# PROJECT_CREDENTIALS_ENCRYPTION_KEY=
# Fallbacks for settings now saved in the app (the app's copy wins):
# Settings > Email > Receiving, Settings > Updates, Settings > Developers.
# RESEND_API_KEY=
# RESEND_INBOUND_WEBHOOK_SECRET=
# PM_GITHUB_TOKEN=
# PM_GITHUB_REPO=
# WEBHOOK_SCHEDULER_ENABLED=
# WEBHOOK_SCHEDULER_SECRET=

# Your own features' variables go in src/custom/env.example.
