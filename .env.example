# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (generate with: openssl rand -hex 32)
PROJECT_CREDENTIALS_ENCRYPTION_KEY=
SMTP_ENCRYPTION_KEY=

# App URL (used for email notification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
# Demo mode disables auth; BOTH flags must be true (DEMO_MODE is the server-only safety latch)
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
NEXT_PUBLIC_ENABLE_AGENTS=false

# Inbound client email (Resend receiving on the relay domain)
# A Resend API key that can read received email. The app only makes GET
# requests to /emails/receiving; it never sends with this key.
RESEND_API_KEY=
# Signing secret (whsec_...) of the email.received webhook pointing at
# /api/inbound-email/resend
RESEND_INBOUND_WEBHOOK_SECRET=
# Optional: comma-separated authserv-ids whose Authentication-Results headers
# are trusted when the provider gives no SPF/DKIM verdict of its own
INBOUND_EMAIL_TRUSTED_AUTHSERV_IDS=

# Vercel Cron (vercel.json): daily inbound email retention and the weekly
# orphan sweep of the inbound-email bucket. Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>". Leave empty to keep both crons off.
# At least 16 characters (generate with: openssl rand -hex 32)
CRON_SECRET=
