# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption: one key for everything the app saves encrypted (email account
# passwords, project credentials, and the integration secrets set in Settings).
# Required. 64 hex characters: the setup wizard generates one, or run
# `openssl rand -hex 32`. A secret: set it in your host too, and keep a safe
# copy, because if it is lost, saved passwords and keys cannot be recovered.
APP_ENCRYPTION_KEY=
# Older installs only: the keys used before APP_ENCRYPTION_KEY. They keep
# opening what was saved under them until Settings > Workspace > Encryption
# has moved it all to the new key; then remove them. New installs leave both empty.
PROJECT_CREDENTIALS_ENCRYPTION_KEY=
SMTP_ENCRYPTION_KEY=

# Only when installing into a Supabase project that already has other apps'
# accounts: any long random text. The setup wizard asks for it before anyone
# can claim the Owner account. Not needed on a project of its own.
PM_SETUP_CODE=

# App URL (used for email notification links)
NEXT_PUBLIC_APP_URL=http://localhost:3009

# Feature Flags
# Demo mode disables auth; BOTH flags must be true (DEMO_MODE is the server-only safety latch)
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
# Which parts of the app are on (AI agents, billing, leads and the rest) is set
# by the Owner in Settings > Workspace > Features, not here.

# Database updates. The direct or session pooler connection string from
# Supabase (Connect), port 5432, never the transaction pooler (6543). A secret:
# set it in your host too. With it, production deploys apply each update's
# database changes before going live (Owners can turn that off in Settings >
# Updates), and `npm run db:migrate` works locally. Optional, but without it
# every update's database changes are applied by hand.
SUPABASE_DB_URL=
# Optional: `false` keeps production deploys from ever changing the database,
# whatever Settings > Updates says. Leave it empty everywhere else.
MIGRATE_ON_DEPLOY=

# Inbound client email (Resend receiving on the relay domain). Optional: an
# Owner can set both in Settings > Email > Receiving instead (saved encrypted),
# which wins over these.
# A Resend API key that can read received email. The app only makes GET
# requests to /emails/receiving; it never sends with this key.
RESEND_API_KEY=
# Signing secret (whsec_...) of the email.received webhook pointing at
# /api/inbound-email/resend
RESEND_INBOUND_WEBHOOK_SECRET=
# Optional: comma-separated authserv-ids whose Authentication-Results headers
# are trusted when the provider gives no SPF/DKIM verdict of its own.
# Keep it UNSET with Resend: Resend gives its own verdict, and anyone who
# mails the relay domain directly can write an Authentication-Results header
# naming any authserv-id into their message, so a listed id could be forged.
INBOUND_EMAIL_TRUSTED_AUTHSERV_IDS=

# Vercel Cron (vercel.json): daily inbound email retention and the weekly
# orphan sweep of the inbound-email bucket. Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>". Leave empty to keep both crons off.
# At least 16 characters (generate with: openssl rand -hex 32)
CRON_SECRET=

# Webhook retries (Supabase pg_cron). Optional: an Owner turns them on in
# Settings > Developers ("Turn on webhook retries"), which makes the secret,
# saves it and writes Vault for you, and wins over these. By hand instead:
# every minute, when a webhook delivery is due, pg_cron POSTs to
# /api/internal/webhooks/scheduled with "Authorization: Bearer <secret>".
# Store the same secret in Supabase Vault as webhook_scheduler_secret and the
# app URL as webhook_scheduler_url. Without them, retries only go out on the
# next invoice change or "send now". 32 to 512 characters.
WEBHOOK_SCHEDULER_ENABLED=
WEBHOOK_SCHEDULER_SECRET=

# In-app updates (Settings > Updates). Optional: an Owner can save the token
# and repository in Settings > Updates instead (saved encrypted), which wins
# over these. Without either, the page shows new releases and the setup steps,
# and you update with `npm run upgrade`.
# A fine-grained GitHub token for this install's repository only (GitHub,
# Settings, Developer settings, Fine-grained tokens), with the permissions
# Settings > Updates lists. A secret: never in git.
PM_GITHUB_TOKEN=
# This install's repository as owner/name. Required with the token.
PM_GITHUB_REPO=
# Only on the install releases are published from: `source`. Leave empty everywhere else.
PM_INSTALL_ROLE=

# Your own features' variables are documented in src/custom/env.example.
