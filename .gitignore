# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# local test stack (npm run local:up): Supabase CLI state and its dev build
/scripts/local/supabase/.temp/
/scripts/local/supabase/.branches/
/scripts/local/supabase/snippets/
/.next-local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
.playwright/

# Claude Code: the shared settings, hook and pm- skills are tracked; local ones are not
.claude/settings.local.json
.claude/worktrees/

# Copied from pdfjs-dist by the postinstall script on every install.
/public/pdf.worker.min.mjs
